{
  "name": "prediction-leaderboard-replica",
  "version": "0.1.0",
  "private": true,
  "description": "Independent demo of a prediction-market trader leaderboard, built for a hiring assignment",
  "author": "Shaik Luqman",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:assets": "node scripts/check-assets.mjs",
    "check:outage": "bash scripts/check-outage-build.sh",
    "lighthouse": "node scripts/lighthouse.mjs",
    "snapshot": "node scripts/update-snapshot.mjs",
    "fixtures:e2e": "node scripts/record-e2e-fixtures.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run check:assets && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
